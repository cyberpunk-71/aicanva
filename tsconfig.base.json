{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@canvas/*": ["apps/web-canvas/src/*"],
      "@server/*": ["server/src/*"],
      "@skybridge/*": ["apps/skybridge-mcp/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
